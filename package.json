{
	"name": "rerun",
	"version": "2.13.0",
	"license": "MIT",
	"devDependencies": {
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/node": "^26.6.6",
		"esbuild": "^0.28.2",
		"eslint": "^10.14.0",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.72.1"
	},
	"allowScripts": {
		"esbuild@0.28.2": true
	},
	"type": "module",
	"exports": {
		"./*": "./target/js/*.js"
	},
	"bin": {
		"rerun": "./bin/rerun.cjs"
	},
	"engines": {
		"node": ">=22",
		"npm": ">=12.0.1"
	},
	"os": [
		"darwin",
		"linux"
	],
	"scripts": {
		"clean": "rm -rf target bin",
		"rate": "npm run compile && npm run lint",
		"dist": "npm run compile && npm run lint && npm run bundle",
		"lint": "eslint src",
		"compile": "tsc --build --verbose tsconfig.json",
		"bundle": "esbuild target/js/rerun.js --outfile=bin/rerun.cjs --tsconfig-raw='{}' --bundle --sourcemap --target=node22 --format=cjs --platform=node --packages=bundle && chmod +x bin/rerun.cjs",
		"preversion": "npm run clean && npm run dist && git add --force bin/ && git commit -m 'add binary'",
		"postversion": "git rm -r --cached bin/ && git commit -m 'remove binary' && git push && git push --tags"
	}
}
